<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>

    <!-- Package metadata -->
    <PackageId>Native.IdentityCore</PackageId>
    <Version>0.2.0</Version>
    <Authors>Swepay</Authors>
    <Description>Shared-kernel support library for Swepay identity products (biometrics, KYC, 3DS): face liveness, per-tenant face index and a pure biometric decision policy over Amazon Rekognition, plus a KMS-backed signer for biometric assertions. Native AOT compatible.</Description>
    <PackageTags>biometrics;liveness;rekognition;identity;kyc;native-aot;kms;jws</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/swepay/native-identity-core</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.Rekognition" />
    <PackageReference Include="AWSSDK.KeyManagementService" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
