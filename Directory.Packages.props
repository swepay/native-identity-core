<Project>

  <!--
    Central Package Management (CPM) — ENABLED.
    Every .csproj references packages WITHOUT a Version attribute; the version
    lives here, once, per package. See:
    https://learn.microsoft.com/nuget/consume-packages/central-package-management
  -->

  <PropertyGroup>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- === AWS SDK === -->
  <ItemGroup>
    <PackageVersion Include="AWSSDK.Rekognition" Version="4.0.100.14" />
    <PackageVersion Include="AWSSDK.KeyManagementService" Version="4.0.100.14" />
    <PackageVersion Include="AWSSDK.Core" Version="4.0.102.6" />
  </ItemGroup>

  <!-- === Microsoft.Extensions === -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <!-- === Tooling === -->
  <ItemGroup>
    <!-- 8.0.0 pulls Microsoft.Build.Tasks.Git 8.0.0 (GHSA-23fw-v26w-5fgq, moderate) — pinned to
         the newer stable line instead of the ecosystem-common 8.0.0 used by older sibling libs. -->
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.401" />
  </ItemGroup>

  <!-- === Test stack (GS-07 — swepay-testing-quality, versões sempre fixas) === -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="Bogus" Version="35.6.1" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
  </ItemGroup>

</Project>
