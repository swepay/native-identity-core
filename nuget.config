<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!--
      Public packages (Microsoft.*, AWSSDK.*, xunit, etc.) come from nuget.org.
      Swepay-internal packages, when this library ever depends on one, are published to a
      private GitHub Packages feed and resolved from the machine's global-packages cache during
      local/offline restore. Configure the private feed in your CI/dev environment
      (NUGET_GITHUB_TOKEN) before a clean restore.
    -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- <add key="swepay-github" value="https://nuget.pkg.github.com/swepay/index.json" /> -->
  </packageSources>
</configuration>
